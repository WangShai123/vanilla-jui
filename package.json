{
  "name": "vanilla-jui",
  "version": "1.5.3",
  "private": false,
  "description": "A lightweight, reactive, and fully customizable vanilla JS UI library.",
  "keywords": [
    "accordion",
    "components",
    "drop",
    "flow",
    "form",
    "jui",
    "menu",
    "modal",
    "offcanvas",
    "pagination",
    "parabola",
    "swiper",
    "tabs",
    "theme",
    "toast",
    "tooltip",
    "validator",
    "vanilla"
  ],
  "homepage": "https://github.com/WangShai123/vanilla-jui",
  "bugs": {
    "url": "https://github.com/WangShai123/vanilla-jui/issues"
  },
  "license": "ISC",
  "author": "Wang Shai <hiwangshai@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WangShai123/vanilla-jui.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "dist/index.umd.js",
  "types": "./dist/index.d.ts",
  "unpkg": "dist/index.umd.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json",
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "pack": "vp pack",
    "dev": "vp dev",
    "test": "vp test",
    "check": "vp check",
    "lint": "vp lint",
    "prepublishOnly": "vp run build"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "lodash-es": "^4.18.1",
    "vanilla-create-storage": "latest",
    "vanilla-signal": "^1.1.4",
    "vanilla-signal-i18n": "latest"
  },
  "devDependencies": {
    "@tsdown/css": "latest",
    "jsdom": "^30.0.1",
    "typescript": "latest",
    "vite-plus": "latest"
  },
  "inlinedDependencies": {
    "lodash-es": "4.18.1"
  },
  "registry": {
    "type": "git",
    "url": "git+https://github.com/WangShai123/vanilla-jui.git"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  }
}
